#
# Complete the 'separateNumbers' function below.
#
# The function accepts STRING s as parameter.
#

def separateNumbers(s):
    n = len(s)
    # The first number can be at most half the length of the string
    for i in range(1, n // 2 + 1):
        # Extract the potential first number
        first_str = s[:i]
        
        # Numbers cannot have leading zeros (unless the string itself is just "0")
        if first_str[0] == '0' and len(first_str) > 1:
            break
            
        current_num = int(first_str)
        built_string = first_str
        
        # Build the subsequent numbers until built_string matches or exceeds length of s
        while len(built_string) < n:
            current_num += 1
            built_string += str(current_num)
            
        # Check if our built string matches the original input string
        if built_string == s:
            print(f"YES {first_str}")
            return
            
    print("NO")

if __name__ == '__main__':
    q = int(input().strip())

    for _ in range(q):
        s = input()
        separateNumbers(s)
