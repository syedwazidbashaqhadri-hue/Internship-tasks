from collections import Counter

#
# Complete the 'anagram' function below.
#
# The function is expected to return an INTEGER.
# The function accepts STRING s as parameter.
#

def anagram(s):
    # If the length of the string is odd, it cannot be split into two equal halves
    if len(s) % 2 != 0:
        return -1
    
    # Split the string into two equal halves
    mid = len(s) // 2
    s1 = s[:mid]
    s2 = s[mid:]
    
    # Count character frequencies for both halves
    count1 = Counter(s1)
    count2 = Counter(s2)
    
    # Find how many characters in s1 need to be changed to match s2
    diff = count1 - count2
    
    # The sum of values in the difference represents the minimum changes required
    return sum(diff.values())

if __name__ == '__main__':
    fptr = open(os.environ['OUTPUT_PATH'], 'w')

    q = int(input().strip())

    for _ in range(q):
        s = input()

        result = anagram(s)

        fptr.write(str(result) + '\n')

    fptr.close()
