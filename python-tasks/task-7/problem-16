#
# Complete the 'caesarCipher' function below.
#
# The function is expected to return a STRING.
# The function accepts following parameters:
#  1. STRING s
#  2. INTEGER k
#

def caesarCipher(s, k):
    encrypted = []
    # Reduce k using modulo 26 to avoid unnecessary full rotations
    k = k % 26
    
    for char in s:
        if char.islower():
            # Shift lowercase letters while keeping them within 'a'-'z' range
            shifted = chr((ord(char) - ord('a') + k) % 26 + ord('a'))
            encrypted.append(shifted)
        elif char.isupper():
            # Shift uppercase letters while keeping them within 'A'-'Z' range
            shifted = chr((ord(char) - ord('A') + k) % 26 + ord('A'))
            encrypted.append(shifted)
        else:
            # Leave symbols, spaces, and numbers unencrypted
            encrypted.append(char)
            
    return "".join(encrypted)

if __name__ == '__main__':
    fptr = open(os.environ['OUTPUT_PATH'], 'w')

    n = int(input().strip())

    s = input()

    k = int(input().strip())

    result = caesarCipher(s, k)

    fptr.write(result + '\n')

    fptr.close()
