#Find the Runner-Up Score!
#https://www.hackerrank.com/challenges/find-second-maximum-number-in-a-list/problem


if __name__ == '__main__':
    n = int(input())
    # Read the scores as a list of integers
    arr = list(map(int, input().split()))
    
    # Remove duplicates by converting to a set, sort them in ascending order, then find the runner-up
    unique_scores = sorted(list(set(arr)))
    
    # The runner-up score will be the second-to-last element in the sorted unique scores
    print(unique_scores[-2])
