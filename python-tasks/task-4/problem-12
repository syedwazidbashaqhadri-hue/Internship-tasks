def average(array):
    # Convert the array to a set to get distinct heights
    distinct_heights = set(array)
    
    # Calculate the average by dividing the sum of distinct heights by their count
    return sum(distinct_heights) / len(distinct_heights)

if __name__ == '__main__':
    n = int(input())
    arr = list(map(int, input().split()))
    result = average(arr)
    print(result)
