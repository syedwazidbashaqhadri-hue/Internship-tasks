#Word Order
#https://www.hackerrank.com/challenges/word-order/problem


from collections import Counter

if __name__ == '__main__':
    n = int(input())
    
    # Use a dictionary or Counter to keep track of word frequencies.
    # In Python 3.7+, standard dict maintains insertion order.
    word_counts = {}
    
    for _ in range(n):
        word = input().strip()
        word_counts[word] = word_counts.get(word, 0) + 1
        
    # Print the number of distinct words
    print(len(word_counts))
    
    # Print the occurrence counts corresponding to the order of first appearance
    print(*(word_counts.values()))
