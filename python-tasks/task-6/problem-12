#Set .union() Operation
#https://www.hackerrank.com/challenges/py-set-union/problem


if __name__ == '__main__':
    # Read English newspaper subscribers count (not strictly needed for set operations in Python)
    n_english = int(input())
    english_subscribers = set(map(int, input().split()))
    
    # Read French newspaper subscribers count
    n_french = int(input())
    french_subscribers = set(map(int, input().split()))
    
    # Find the union of both sets to get unique students subscribed to at least one newspaper
    total_students = english_subscribers.union(french_subscribers)
    
    # Print the total count of unique students
    print(len(total_students))
