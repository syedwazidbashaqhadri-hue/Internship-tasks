    # Read the number of elements (though not strictly necessary to use in Python due to split)
    n = int(input())
    
    # Read space-separated integers, convert them to integers, and pack them into a tuple
    integer_list = tuple(map(int, input().split()))
    
    # Compute and print the hash of the tuple
    print(hash(integer_list))
