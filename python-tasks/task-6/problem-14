#Set .intersection() Operation
#https://www.hackerrank.com/challenges/py-set-intersection-operation/problem


if __name__ == '__main__':
    # Read English subscribers count and roll numbers
    n = int(input())
    english_subscribers = set(map(int, input().split()))
    
    # Read French subscribers count and roll numbers
    b = int(input())
    french_subscribers = set(map(int, input().split()))
    
    # Find the intersection of both sets (students subscribed to both)
    both_subscribers = english_subscribers.intersection(french_subscribers)
    
    # Print the total number of students
    print(len(both_subscribers))
